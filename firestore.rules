rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/hero_users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/hero_users/$(request.auth.uid)).data.role == 'admin';
    }

    match /hero_users/{uid} {
      // Own doc or admin can read; admin can list the whole collection.
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());

      // Any authenticated user can create their own doc on first login.
      allow create: if request.auth != null && request.auth.uid == uid;

      // User can update their own doc but NOT change their own role.
      // Admin can update any doc (including role changes).
      allow update: if request.auth != null && (
        (
          request.auth.uid == uid &&
          !('role' in request.resource.data.diff(resource.data).affectedKeys())
        ) ||
        isAdmin()
      );

      // Admin can remove a user doc (e.g. to reset their access).
      allow delete: if isAdmin();
    }

    match /hero_invited_emails/{email} {
      // Admin can create/update/delete invitations.
      allow write: if isAdmin();
      // Any authenticated user can read their own invitation doc on sign-in.
      allow read: if request.auth != null;
    }

    // All other collections are denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
